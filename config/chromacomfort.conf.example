# ChromaComfort Linux bridge configuration

[bluetooth]
# Bluetooth Classic MAC address of your ChromaComfort device.
# Replace this obvious placeholder with the address reported by bluetoothctl.
address = AA:BB:CC:DD:EE:FF

# Channel 7 was confirmed by SDP on the tested ChromaComfort-Sensonic unit.
# Verify with `sdptool browse <MAC>` if your model differs.
rfcomm_channel = 7

# The daemon manages: rfcomm connect 0 <MAC> <channel>
rfcomm_number = 0
rfcomm_device = /dev/rfcomm0

reconnect_seconds = 5
command_retry_seconds = 0.10
command_timeout_seconds = 5

[mqtt]
# Home Assistant / Mosquitto broker address.
# 192.0.2.0/24 is reserved for documentation; replace with your broker address.
host = 192.0.2.10
port = 1883
username = chromacomfort
password = CHANGE_ME

topic_prefix = chromacomfort/bathroom
discovery_prefix = homeassistant

[device]
name = Bathroom ChromaComfort
id = chromacomfort_bathroom
