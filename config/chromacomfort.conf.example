# ChromaComfort Linux bridge configuration

[bluetooth]
# Bluetooth Classic MAC address of the ChromaComfort device.
address = 04:57:91:F1:14:AB

# Confirmed by SDP on the tested ChromaComfort-Sensonic unit.
rfcomm_channel = 7

# The daemon manages: rfcomm connect 0 <MAC> <channel>
rfcomm_number = 0
rfcomm_device = /dev/rfcomm0

reconnect_seconds = 5
command_retry_seconds = 0.10
command_timeout_seconds = 5

[mqtt]
# Home Assistant / Mosquitto broker address.
host = 10.0.0.10
port = 1883
username = chromacomfort
password = CHANGE_ME

topic_prefix = chromacomfort/bathroom
discovery_prefix = homeassistant

[device]
name = Bathroom ChromaComfort
id = chromacomfort_bathroom
