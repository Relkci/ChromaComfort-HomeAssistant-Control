general =
{
    name = "__AIRPLAY_NAME__";

    # Use Shairport's ALSA backend through PipeWire's ALSA plugin rather than
    # the PulseAudio compatibility backend. On the tested system, the pa
    # backend remained corked after an AirPlay pause and would not resume
    # until Shairport Sync was restarted. The ALSA -> PipeWire path resumes
    # normally after pause/play transitions.
    output_backend = "alsa";

    # The ALSA -> PipeWire -> Bluetooth path was audibly choppy/clippy with the
    # smaller default backend buffer. A 0.5 second desired backend buffer
    # eliminated the observed dropouts on the validated ChromaComfort host.
    audio_backend_buffer_desired_length_in_seconds = 0.5;

    # Bluetooth A2DP latency and Shairport's normal synchronization logic did
    # not coexist reliably on the tested ChromaComfort speaker.
    disable_synchronization = "yes";

    # Keep AirPlay/Spotify source volume control, but avoid the very large
    # default software attenuation range that made normal playback inaudible.
    ignore_volume_control = "no";
    volume_range_db = 30;
    volume_max_db = 0.0;
    volume_control_profile = "flat";
};

alsa =
{
    # pipewire-alsa exposes this PCM and routes it into the chromaudio user's
    # PipeWire graph. WirePlumber then routes to the default ChromaComfort
    # A2DP sink selected by the boot-readiness logic.
    output_device = "pipewire";
};
